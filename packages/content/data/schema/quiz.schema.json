              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "guiltyPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "draft": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "text",
              "guiltyPercent"
            ],
            "additionalProperties": false
          }
