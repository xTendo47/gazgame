      "required": [
        "id",
        "title",
        "subtitle",
        "kind",
        "from",
        "count",
        "ladder",
        "safe",
        "prize"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "_note": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
