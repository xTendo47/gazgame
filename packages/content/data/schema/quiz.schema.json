          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ladder": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "prize": {
          "type": "string",
          "minLength": 1
        }
