{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "texts": {
      "type": "object",
      "properties": {
        "free": {
          "type": "string",
          "minLength": 1
        },
        "premium": {
          "type": "string",
          "minLength": 1
        },
        "soon": {
          "type": "string",
          "minLength": 1
        },
        "soonToast": {
          "type": "string",
          "minLength": 1
        },
        "kindsAll": {
          "type": "string",
          "minLength": 1
        },
        "kindsOne": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "free",
        "premium",
        "soon",
        "soonToast",
        "kindsAll",
        "kindsOne"
      ],
      "additionalProperties": false
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "pairs",
              "company",
              "solo"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lead": {
            "type": "string",
            "minLength": 1
          },
          "tabs": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "emoji": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "premium": {
                  "type": "boolean"
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "kinds": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "emoji": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "emoji",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "head": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "emoji": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "levels": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "premium": {
                              "type": "boolean"
                            },
                            "free": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "soon": {
                        "type": "boolean"
                      },
                      "premium": {
                        "type": "boolean"
                      },
                      "kind": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "ref": {
                        "type": "object",
                        "properties": {
                          "game": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "test": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "lockedTest": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "cards": {
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "emoji",
                      "title",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "emoji",
                "name",
                "items"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "lead",
          "tabs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "texts",
    "sections"
  ],
  "additionalProperties": false
}
