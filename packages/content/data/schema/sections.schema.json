{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "texts": {
      "type": "object",
      "properties": {
        "free": {
          "type": "string",
          "minLength": 1
        },
        "premium": {
          "type": "string",
          "minLength": 1
        },
        "soon": {
          "type": "string",
          "minLength": 1
        },
        "soonToast": {
          "type": "string",
          "minLength": 1
        },
        "kindsAll": {
          "type": "string",
          "minLength": 1
        },
        "kindsOne": {
          "type": "string",
          "minLength": 1
        },
        "rulesTitle": {
          "type": "string",
          "minLength": 1
        },
        "play": {
          "type": "string",
          "minLength": 1
        },
        "later": {
          "type": "string",
          "minLength": 1
        },
        "premiumHint": {
          "type": "string",
          "minLength": 1
        },
        "compareHint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "free",
        "premium",
        "soon",
        "soonToast",
        "kindsAll",
        "kindsOne",
        "rulesTitle",
        "play",
        "later",
        "premiumHint",
        "compareHint"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dice": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sub": {
          "type": "string",
          "minLength": 1
        },
        "askSize": {
          "type": "string",
          "minLength": 1
        },
        "askMood": {
          "type": "string",
          "minLength": 1
        },
        "roll": {
          "type": "string",
          "minLength": 1
        },
        "again": {
          "type": "string",
          "minLength": 1
        },
        "play": {
          "type": "string",
          "minLength": 1
        },
        "empty": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "mood": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "size",
            "mood"
          ],
          "additionalProperties": false
        },
        "sizes": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "label",
              "items"
            ],
            "additionalProperties": false
          }
        },
        "moods": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "label",
              "items"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "sub",
        "askSize",
        "askMood",
        "roll",
        "again",
        "play",
        "empty",
        "default",
        "sizes",
        "moods"
      ],
      "additionalProperties": false
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "pairs",
              "company",
              "solo"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lead": {
            "type": "string",
            "minLength": 1
          },
          "tabs": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "emoji": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "premium": {
                  "type": "boolean"
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "kinds": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "emoji": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "emoji",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "head": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "emoji": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "levels": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "premium": {
                              "type": "boolean"
                            },
                            "free": {
                              "type": "boolean"
                            },
                            "compare": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "soon": {
                        "type": "boolean"
                      },
                      "new": {
                        "type": "boolean"
                      },
                      "players": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minutes": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "premium": {
                        "type": "boolean"
                      },
                      "kind": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "ref": {
                        "type": "object",
                        "properties": {
                          "game": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "query": {
                            "type": "string",
                            "pattern": "^[a-z0-9=&-]+$"
                          },
                          "test": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "lockedTest": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                          },
                          "cards": {
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "emoji",
                      "title",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "emoji",
                "name",
                "items"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "lead",
          "tabs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "texts",
    "rules",
    "dice",
    "sections"
  ],
  "additionalProperties": false
}
