{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "tile": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "subtitle"
      ],
      "additionalProperties": false
    },
    "header": {
      "type": "string",
      "minLength": 1
    },
    "badge": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lead": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "emoji": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "object",
                  "properties": {
                    "game": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "deck": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "extras": {
                      "type": "boolean",
                      "const": true
                    },
                    "compat": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "lockedTests": {
                      "type": "boolean",
                      "const": true
                    },
                    "always": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "emoji",
          "title",
          "line",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "soon": {
      "type": "string",
      "minLength": 1
    },
    "sheetClose": {
      "type": "string",
      "minLength": 1
    },
    "fresh": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "emoji",
        "text",
        "accent"
      ],
      "additionalProperties": false
    },
    "cta": {
      "type": "string",
      "minLength": 1
    },
    "paySheet": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "button": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "text",
        "button",
        "done"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "link": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "button": {
          "type": "string",
          "minLength": 1
        },
        "cancel": {
          "type": "string",
          "minLength": 1
        },
        "wrong": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "link",
        "title",
        "placeholder",
        "button",
        "cancel",
        "wrong"
      ],
      "additionalProperties": false
    },
    "fine": {
      "type": "string",
      "minLength": 1
    },
    "on": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "tileState": {
          "type": "string",
          "minLength": 1
        },
        "cta": {
          "type": "string",
          "minLength": 1
        },
        "fine": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "lead",
        "tileState",
        "cta",
        "fine"
      ],
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1
        },
        "learn": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "unlock": {
          "type": "string",
          "minLength": 1
        },
        "close": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "why",
        "learn",
        "example",
        "unlock",
        "close"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tile",
    "header",
    "badge",
    "title",
    "lead",
    "sections",
    "soon",
    "sheetClose",
    "fresh",
    "cta",
    "paySheet",
    "code",
    "fine",
    "on",
    "preview"
  ],
  "additionalProperties": false
}
