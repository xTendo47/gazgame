{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "emoji": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pairs",
          "company",
          "solo"
        ]
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "filter": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "label",
        "options"
      ],
      "additionalProperties": false
    },
    "decks": {
      "type": "object",
      "properties": {
        "36": {
          "type": "string",
          "minLength": 1
        },
        "52": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "36",
        "52"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "players": {
          "type": "string",
          "minLength": 1
        },
        "minutes": {
          "type": "string",
          "minLength": 1
        },
        "deck": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "deal": {
          "type": "string",
          "minLength": 1
        },
        "moves": {
          "type": "string",
          "minLength": 1
        },
        "disputes": {
          "type": "string",
          "minLength": 1
        },
        "back": {
          "type": "string",
          "minLength": 1
        },
        "empty": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "players",
        "minutes",
        "deck",
        "goal",
        "deal",
        "moves",
        "disputes",
        "back",
        "empty"
      ],
      "additionalProperties": false
    },
    "games": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "emoji": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "aka": {
            "type": "string",
            "minLength": 1
          },
          "players": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "minutes": {
            "type": "string",
            "minLength": 1
          },
          "deck": {
            "anyOf": [
              {
                "type": "number",
                "const": 36
              },
              {
                "type": "number",
                "const": 52
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "intro": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "deal": {
            "type": "string",
            "minLength": 1
          },
          "moves": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extra": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "title",
                "items"
              ],
              "additionalProperties": false
            }
          },
          "disputes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "emoji",
          "title",
          "players",
          "minutes",
          "deck",
          "goal",
          "deal",
          "moves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "emoji",
    "sections",
    "subtitle",
    "filter",
    "decks",
    "labels",
    "games"
  ],
  "additionalProperties": false
}
